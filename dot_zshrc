# Source - https://superuser.com/a/1765422
# Posted by Ján Halaša
# Retrieved 2026-10-13, License - CC BY-SA 4.0

function kill-path-word()
{
  local words word spaces
  zle set-mark-command                 # save current cursor position ("mark")
  words=($(grep -Eo '(/?[a-zA-Z1-9]+[\\ /]*)|([^a-zA-Z0-9])' <<< "$LBUFFER"))
  word=$words[-1]                       # this is the portion from cursor back to previous "/"
  while [[ $LBUFFER[-1] == " " ]] {
    (( CURSOR -= 1 ))                   # consume all trailing spaces - they don't get into the $word variable
  }
  (( CURSOR -= $#word ))                # then, jump to the previous "/"
  zle exchange-point-and-mark           # swap "mark" and "cursor"
  zle kill-region                       # delete marked region
}
zle -N kill-path-word
bindkey "^[^?" kill-path-word

# zsh-autosuggestions
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# zsh-vi-mode
# must be defined BEFORE sourcing the plugin
function zvm_after_init() {
  # ctrl+space -> accept autosuggestion
  bindkey -M viins '^@' autosuggest-accept

  # ctrl+backspace
  bindkey -M viins '^H' kill-path-word

  # ctrl+delete
  bindkey -M viins '\e[3;5~' kill-word
  # urxvt ctrl+delete
  bindkey -M viins '\e[3^' kill-word

  # ctrl+shift+delete
  bindkey -M viins '\e[3;6~' kill-line
  # urxvt ctrl+shift+delete
  bindkey -M viins '\e[3@' kill-line

  # ctrl+arrows
  bindkey -M viins '\e[1;5C' forward-word
  bindkey -M viins '\e[1;5D' backward-word
  # urxvt ctrl+arrows
  bindkey -M viins '\eOc' forward-word
  bindkey -M viins '\eOd' backward-word
}
source $HOME/.local/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh


#------------------------------
# Window title
#------------------------------
case $TERM in
  termite|*xterm*|rxvt|rxvt-unicode|rxvt-256color|rxvt-unicode-256color|(dt|k|E)term)
    precmd () {
      print -Pn "\e]0;[%n@%M][%~]\a"
    } 
    preexec () { print -Pn "\e]0;[%n@%M][%~] ($1)\a" }
    ;;
  screen|screen-256color)
    precmd () { 
      print -Pn "\e]83;title \"$1\"\a" 
      print -Pn "\e]0;$TERM - (%L) [%n@%M] [%~]\a" 
    }
    preexec () { 
      print -Pn "\e]83;title \"$1\"\a" 
      print -Pn "\e]0;$TERM - (%L) [%n@%M] [%~] ($1)\a" 
    }
    ;; 
esac

eval "$(starship init zsh)"
