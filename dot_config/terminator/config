[global_config]
  ask_before_closing = never
[keybindings]
[profiles]
  [[default]]
    font = FiraCode Nerd Font Mono 11
    foreground_color = "#e53c00"
    show_titlebar = False
    scrollback_infinite = True
    palette = "#2e3436:#cc0000:#4e9a06:#c4a000:#3465a4:#75507b:#06989a:#d3d7cf:#9a9996:#ef2929:#8ae234:#fce94f:#729fcf:#ad7fa8:#34e2e2:#eeeeec"
    use_system_font = False
    use_theme_colors = True
    copy_on_selection = True
    title_transmit_bg_color = "#2e2e32"
    title_inactive_fg_color = "#8e8e90"
    title_inactive_bg_color = "#222226"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
