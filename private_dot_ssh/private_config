# vim: ft=sshconfig

# SCC/NET connections
Host entry-*.tmn.scc.kit.edu net-admin.tmn.scc.kit.edu 
  User fischer
  ForwardAgent yes

Host socks:scc-tmn
  DynamicForward 3128
  HostName entry-1.tmn.scc.kit.edu
  User fischer
  ProxyJump net-li-cs.scc.kit.edu

Host net-li-c*.scc.kit.edu
  # SSH multiplexing: open a socket on the designated path
  # new connections use that path until ControlPersist timeout kills the session
  ControlMaster auto
  ControlPath ~/.ssh/control/%h_%p_%r # NOTE: you might want to change this to `~/.ssh/control/%h_%p_%r` but you have to make sure, you create the directory first: `mkdir -p ~/.ssh/control && chmod 700 ~/.ssh/control`
  ControlPersist 12h
  AddKeysToAgent no # this would add the "safe" key first. We want the unsafe key to be added first, so that is being prefferred
  ProxyJump none
  User fischer

# NOTE: Gitlab & Github do not yet allow security keys, so for this a separate key is required 
Host gitlab.net.scc.kit.edu
  IdentityFile ~/.ssh/ssh-keys/vcs.ed25519
  PreferredAuthentications publickey
  User git

Host github.com gitlab.com gitlab.kit.edu
  ProxyJump none

# Match KIT-IPs and don't use proxies when in the same network
Match localnetwork 129.13.0.0/16,141.3.0.0/16,141.52.0.0/16,185.237.152.0/22,193.196.32.0/20,2a00:1398::/32,2a00:139e::/32,2001:7c7:2000::/40
  ProxyJump none
  
Host *.kit.edu *.bwnetops.de
  IdentityFile ~/.ssh/ssh-keys/scc-net/id_primary_unsafe
  IdentityFile ~/.ssh/ssh-keys/scc-net/id_primary
  ProxyJump net-li-cs.scc.kit.edu

# General settings
Host *
  Port 22
  TCPKeepAlive no
  ServerAliveCountMax 30
  ServerAliveInterval 10
  IdentityFile ~/.ssh/ssh-keys/id_ed25519
  IdentitiesOnly yes
  # source: https://infosec.mozilla.org/guidelines/openssh#modern
  # Host keys the client accepts - order here is honored by OpenSSH
  HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,ssh-rsa-cert-v01@openssh.com,ssh-rsa,ecdsa-sha2-nistp521-cert-v01@openssh.com,ecdsa-sha2-nistp384-cert-v01@openssh.com,ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp521,ecdsa-sha2-nistp384,ecdsa-sha2-nistp256
  KexAlgorithms curve25519-sha256@libssh.org,ecdh-sha2-nistp521,ecdh-sha2-nistp384,ecdh-sha2-nistp256,diffie-hellman-group-exchange-sha256
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com,hmac-sha2-512,hmac-sha2-256,umac-128@openssh.com
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
  
  IdentitiesOnly yes
  AddKeysToAgent 8h
